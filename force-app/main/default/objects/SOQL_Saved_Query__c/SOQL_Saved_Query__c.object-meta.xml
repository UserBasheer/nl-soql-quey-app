<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>SOQL Saved Query</label>
    <pluralLabel>SOQL Saved Queries</pluralLabel>
    <deploymentStatus>Deployed</deploymentStatus>
    <description
  >User-saved SOQL Whisperer query, named and stored deliberately for reuse. Stores query text and originating prompt/object-scope only — never result rows. Owner-only (Private) because saved SOQL text may contain PHI in WHERE-clause literals.</description>
    <externalSharingModel>Private</externalSharingModel>
    <sharingModel>Private</sharingModel>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>false</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <nameField>
        <label>Saved Query Name</label>
        <trackHistory>false</trackHistory>
        <type>Text</type>
    </nameField>
</CustomObject>
