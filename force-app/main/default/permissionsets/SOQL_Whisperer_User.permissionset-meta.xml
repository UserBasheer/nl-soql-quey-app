<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>SOQL Whisperer User</label>
    <description
  >Required assignment for SOQL Whisperer users. Grants the object/field access needed for query history logging, saved queries, Apex class access, and the export-to-CSV custom permission. Without this permission set the feature is inert under USER_MODE DML.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <classAccesses>
        <apexClass>SoqlWhispererController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>QueryHistoryService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>SavedQueryService</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <customPermissions>
        <enabled>true</enabled>
        <name>Export_Query_Results</name>
    </customPermissions>

    <objectPermissions>
        <object>SOQL_Query_History__c</object>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>SOQL_Saved_Query__c</object>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <fieldPermissions>
        <field>SOQL_Query_History__c.SOQL__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>SOQL_Query_History__c.Natural_Language__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>SOQL_Query_History__c.Object_Scope__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>SOQL_Query_History__c.Row_Count__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>SOQL_Query_History__c.Status__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>SOQL_Query_History__c.Error_Message__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <field>SOQL_Saved_Query__c.SOQL__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>SOQL_Saved_Query__c.Natural_Language__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>SOQL_Saved_Query__c.Object_Scope__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
